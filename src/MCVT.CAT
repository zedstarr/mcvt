IMAGE mcvt

EXTERNAL olib
EXTERNAL wimp

INCLUDE wimp.g

CLASS mcvtws w68
window server client (class 0 - created by the WIMP app manager)
    {
    REPLACE w68_m30
    REPLACE w68_m29
    }

CLASS mcvtcom w66
command manager (class 1): menu commands are its methods
    {
    REPLACE w66_m8
    ADD mcvtcom_clear
    ADD mcvtcom_reset
    ADD mcvtcom_serial
    ADD mcvtcom_term
    }

CLASS mcvtwin w18
terminal window
    {
    REPLACE w14_m30
    REPLACE w0_m23
    REPLACE w14_m33
    REPLACE w14_m34
    REPLACE w18_m44
    }

CLASS mcvtser active
serial input: run when a read completes
    {
    REPLACE ao_run
    }

CLASS mcvtdlg w32
Terminal options dialog
    {
    REPLACE w31_m62
    REPLACE w31_m63
    }
